# Keep this file free of secrets. Copy to .env.local before adding your own key.
OPENAI_API_KEY=
OPENAI_API_ENABLED=0
# Text requests have no local cap. Usage is shown in the administrator cabinet.
INWORLD_API_KEY=
INWORLD_API_ENABLED=0
INWORLD_VOICE_ID=Svetlana
# Selected human avatars. Keys stay on the Python server.
CARTESIA_API_KEY=
CARTESIA_API_ENABLED=0
TAVUS_API_KEY=
TAVUS_API_ENABLED=0
# Optional reusable Echo PAL. If blank, created once per server process.
TAVUS_PAL_ID=
ANAM_API_KEY=
ANAM_API_ENABLED=0
# Protect free avatar minutes. Text sessions/reports are not capped by this timer.
AVATAR_SESSION_SECONDS=180
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Set GPU only on the teammate's CUDA server: cuda / float16.
# Silero VAD and Smart Turn models are bundled with Pipecat, run on the server.
